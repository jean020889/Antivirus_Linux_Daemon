{
  "_comment": "Copia este archivo a config.local.json y ajusta las rutas personales.",
  "cuarentena": "~/antivirus_cuarentena",
  "logs": "./logs",
  "max_firmas": 300000,
  "temp_extract": "/tmp/av_extract",
  "clamd_pool_size": 4,
  "umbral_riesgo": 0.7,
  "sigma_rules_dir": "sigma_rules",
  "realtime_dirs": [
    "~/",
    "/tmp",
    "/var/tmp"
  ],
