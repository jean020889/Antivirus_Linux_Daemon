    {
      "id": 1,
      "name": "Analisis Completo del Sistema",
      "type": "full_system",
      "hour": 3,
      "minute": 0,
      "active": true
    },
    {
      "id": 2,
      "name": "Analisis de Carpeta Descargas",
      "type": "folder",
      "folder_path": "~/Descargas",
      "hour": 14,
      "minute": 30,
      "active": true
    },
    {
      "id": 3,
      "name": "Analisis Nocturno de /tmp",
      "type": "folder",
      "folder_path": "/tmp",
      "hour": 22,
      "minute": 0,
      "active": true
    }
  ],
  "sandbox_enabled": true,
  "zero_day_enabled": true,
  "risk_threshold": 0.5
}