# core/realtime.py
"""
Vigilancia en tiempo real usando inotify directamente (sin watchdog).

Usa el módulo `inotify` de Python (o fallback a polling si no está disponible).
Esta versión es más robusta y loggea todos los eventos para diagnóstico.
"""

import os
import time
import threading
import select
from .archives import ArchiveScanner


class Colors:
    RED = '\033[91m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    BLUE = '\033[94m'
    RESET = '\033[0m'
    BOLD = '\033[1m'


# Intentar importar inotify nativo (más fiable que watchdog)
try:
    import inotify.adapters
    import inotify.constants
    HAS_INOTIFY = True
except ImportError:
    HAS_INOTIFY = False


class RealtimeMonitor:
    """
    Vigilancia en tiempo real usando inotify (nativo) con polling como respaldo.
    """

    def __init__(self, engine, config):
        self.engine = engine
        self.config = config
        self._running = False
        self._thread = None
        self._recently_scanned = {}
        self._debounce_seconds = 2
        self.archive_scanner = ArchiveScanner(
            engine,
            config.get('temp_extract', '/tmp/av_extract')
        )

    def _should_scan(self, path):
        """Debounce para evitar escanear el mismo archivo múltiples veces."""
        now = time.time()
        last = self._recently_scanned.get(path, 0)
        if now - last < self._debounce_seconds:
            return False
        self._recently_scanned[path] = now
        # Limpiar caché si crece demasiado
        if len(self._recently_scanned) > 10000:
            cutoff = now - 60
            self._recently_scanned = {
                k: v for k, v in self._recently_scanned.items() if v > cutoff
            }
        return True

    def _scan_file(self, path):
        """Escanea un archivo y toma acción si es malicioso."""
        if not os.path.isfile(path) or os.path.islink(path):
            return
        if not self._should_scan(path):
            return

        try:
            infectado, motivo = self.engine.scan_file(path)
            if infectado:
                print(f"{Colors.RED}🔥 [REAL-TIME] Amenaza en {path}{Colors.RESET}")
                print(f"{Colors.YELLOW}   └─ {motivo}{Colors.RESET}")
                result = self.engine.quarantine(path, motivo)
                if result:
                    print(f"{Colors.GREEN}   └─ ✅ Aislado en cuarentena: {result}{Colors.RESET}")
                else:
                    print(f"{Colors.RED}   └─ ❌ NO se pudo aislar{Colors.RESET}")
            elif self.archive_scanner:
                # Solo para archivos comprimidos, no todos
                ext = os.path.splitext(path)[1].lower()
                if ext in ('.zip', '.tar', '.gz', '.bz2', '.rar', '.7z', '.xz'):
                    is_inf, arch_motivo = self.archive_scanner.extract_and_scan(path)
                    if is_inf:
                        print(f"{Colors.RED}🔥 [REAL-TIME-ARCHIVE] Amenaza en {path}{Colors.RESET}")
                        print(f"{Colors.YELLOW}   └─ {arch_motivo}{Colors.RESET}")
                        result = self.engine.quarantine(path, f"Comprimido malicioso: {arch_motivo}")
                        if result:
                            print(f"{Colors.GREEN}   └─ ✅ Aislado en cuarentena{Colors.RESET}")
        except Exception as e:
            # No silenciamos: queremos ver errores
            print(f"{Colors.RED}[!] Error escaneando {path}: {e}{Colors.RESET}")

    def start(self):
        """Inicia la vigilancia (BLOQUEANTE - debe correr en un thread externo).
        En antivirus.py se llama desde un thread separado."""
        self._running = True
        self._run()  # BLOQUEANTE: se ejecuta en el thread que llama a start()

    def _run(self):
        """Loop principal: inotify + polling de respaldo."""
        dirs = self.config.get('realtime_dirs', ['/home', '/tmp'])
        print(f"{Colors.BOLD}{Colors.BLUE}[+] Iniciando vigilancia en: {dirs}{Colors.RESET}")

        if HAS_INOTIFY:
            print(f"{Colors.GREEN}[+] Usando inotify nativo{Colors.RESET}")
            self._run_inotify(dirs)
        else:
            print(f"{Colors.YELLOW}[!] inotify-python no disponible. Usando polling.{Colors.RESET}")
            self._run_polling(dirs)

    def _run_inotify(self, dirs):
        """Vigilancia con inotify-python."""
        import inotify.adapters

        i = inotify.adapters.Inotify()
        watched = 0

        for d in dirs:
            real_d = os.path.realpath(d)
            if not os.path.exists(real_d):
                continue
            try:
                i.add_watch(real_d, mask=(
                    inotify.constants.IN_CREATE |
                    inotify.constants.IN_MODIFY |
                    inotify.constants.IN_MOVED_TO |
                    inotify.constants.IN_CLOSE_WRITE
                ))
                print(f"{Colors.GREEN}[+] Vigilando: {d}{Colors.RESET}")
                watched += 1
            except Exception as e:
                print(f"{Colors.YELLOW}[!] No se pudo vigilar {d}: {e}{Colors.RESET}")

        if watched == 0:
            print(f"{Colors.RED}[!] No hay directorios válidos para vigilar{Colors.RESET}")
            return

        print(f"{Colors.GREEN}[+] Vigilancia activa ({watched} directorios){Colors.RESET}")

        # Loop de eventos
        try:
            for event in i.event_gen(yield_nones=False):
                if not self._running:
                    break

                (_, type_names, path, filename) = event

                # Filtrar eventos relevantes
                if not any(t in type_names for t in
                           ['IN_CREATE', 'IN_MODIFY', 'IN_MOVED_TO', 'IN_CLOSE_WRITE']):
                    continue

                full_path = os.path.join(path, filename) if filename else path

                # Solo escanear archivos (no directorios)
                if os.path.isfile(full_path) and not os.path.islink(full_path):
                    self._scan_file(full_path)
        except Exception as e:
            print(f"{Colors.RED}[!] Error en loop inotify: {e}{Colors.RESET}")
            # Fallback a polling
            self._run_polling(dirs)

    def _run_polling(self, dirs):
        """Vigilancia por polling (fallback si inotify no funciona)."""
        print(f"{Colors.YELLOW}[+] Modo polling: escaneo cada 10 segundos{Colors.RESET}")

        known_files = set()
        # Primera pasada: registrar archivos existentes
        for d in dirs:
            if not os.path.exists(d):
                continue
            for root, _, files in os.walk(d):
                for f in files:
                    known_files.add(os.path.join(root, f))

        print(f"{Colors.GREEN}[+] Polling activo. Registrados {len(known_files)} archivos.{Colors.RESET}")

        while self._running:
            time.sleep(10)
            now = time.time()
            new_files = []

            for d in dirs:
                if not os.path.exists(d):
                    continue
                for root, _, files in os.walk(d):
                    for f in files:
                        full = os.path.join(root, f)
                        if full in known_files:
                            continue
                        known_files.add(full)
                        new_files.append(full)

            # Escanear nuevos archivos
            for f in new_files:
                if self._running:
                    self._scan_file(f)

            # Limitar caché
            if len(known_files) > 100000:
                known_files = set(list(known_files)[-50000:])

    def stop(self):
        """Detiene la vigilancia."""
        self._running = False
        if self._thread and self._thread.is_alive():
            try:
                self._thread.join(timeout=5)
            except Exception:
                pass
        print(f"{Colors.GREEN}[+] Vigilancia detenida{Colors.RESET}")
