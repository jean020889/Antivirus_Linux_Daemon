# Antivirus Pro EDR — Variables de entorno
# Copia a .env y rellena:
#   cp .env.example .env
# Genera secretos:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'

# PostgreSQL
POSTGRES_USER=antivirus
POSTGRES_PASSWORD=REEMPLAZA_CON_SECRETO
POSTGRES_DB=antivirus_pro

# Daemon / API
AV_DB_PASS=REEMPLAZA_CON_SECRETO
AV_API_KEY=REEMPLAZA_CON_TOKEN

# Dashboard web
AV_API_TOKEN=REEMPLAZA_CON_TOKEN

# Clave de cifrado de cuarentena (¡CRÍTICA! Sin ella, cuarentena falla)
AV_QUARANTINE_KEY=REEMPLAZA_CON_SECRETO

# Abuse.ch (opcional)
ABUSE_CH_KEY=
